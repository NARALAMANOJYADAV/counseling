{
    "liveServer.settings.port": 5501,
    "liveServer.settings.proxy": {
        "enable": true,
        "baseUri": "/",
        "proxyUri": "http://127.0.0.1:8000/"
    },
    "livePreview.proxyUrl": "http://127.0.0.1:8000/",
    "livePreview.defaultPreviewUrl": "http://127.0.0.1:8000/",
    "livePreview.port": 3000,
    "livePreview.serverRoot": "./",
    "task.allowAutomaticTasks": "on",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.git": true
    },
    "python.terminal.activateEnvInSelectedTerminal": true,
    "python.defaultInterpreterPath": "${workspaceFolder}\\venv\\Scripts\\python.exe",
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "remote.portsAttributes": {
        "8000": {
            "label": "Django Server",
            "onAutoForward": "openBrowser"
        }
    }
}